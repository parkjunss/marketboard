# Copy to .env (gitignored) on the deploy host and fill in real values.
# docker compose reads .env from the project root automatically.

# --- MySQL ---
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# --- Backend ---
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_SEED_EMAIL=admin@marketboard.local
ADMIN_SEED_PASSWORD=change-me
# Must match wherever the frontend is actually served from (browser Origin header).
CORS_ALLOWED_ORIGINS=https://marketboard.duckdns.org

# --- Collector ---
FINNHUB_API_KEY=your-finnhub-api-key

# --- Frontend (baked in at image build time, not read at container runtime) ---
NEXT_PUBLIC_API_BASE_URL=https://marketboard.duckdns.org
NEXT_PUBLIC_WS_URL=https://marketboard.duckdns.org/ws

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin
# Discord channel webhook (Server Settings > Integrations > Webhooks) that alert rules in
# observability/grafana/provisioning/alerting/ notify. Leave unset to deploy safely — Grafana
# just won't be able to deliver alerts until this is set to a real webhook URL.
GRAFANA_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/0/unset

# --- nginx / Let's Encrypt / DuckDNS (public HTTPS access) ---
# DuckDNS token for your account, and the subdomain (just "marketboard", not the
# full "marketboard.duckdns.org") registered under it.
DUCKDNS_TOKEN=your-duckdns-token
DUCKDNS_SUBDOMAIN=marketboard
# Used by nginx/init-letsencrypt.sh when requesting the cert (Let's Encrypt expiry notices).
LETSENCRYPT_EMAIL=you@example.com
