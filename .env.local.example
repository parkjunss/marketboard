# Copy to .env.local and keep it untracked.
# Usage: docker compose --env-file .env.local -f compose.local.yml up -d --build

FINNHUB_API_KEY=replace-with-your-key

# All host ports are intentionally different from the deployment stack and common dev ports.
LOCAL_MYSQL_PORT=13308
LOCAL_REDIS_PORT=16380
LOCAL_COLLECTOR_PORT=18001
LOCAL_BACKEND_PORT=18081
LOCAL_FRONTEND_PORT=13100

LOCAL_DB_PASSWORD=marketboard-local
LOCAL_MYSQL_ROOT_PASSWORD=marketboard-local-root
LOCAL_JWT_SECRET=local-development-secret-change-before-sharing
LOCAL_ADMIN_EMAIL=admin@marketboard.local
LOCAL_ADMIN_PASSWORD=ChangeMe1234!

SP500_BATCH_PERIOD=2y
DAILY_BATCH_HOUR_UTC=6
